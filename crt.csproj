<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>crt</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>CRT Overlay</Product>
    <Description>Real-time CRT atmosphere for games and video on the Windows desktop.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 CRT Overlay contributors</Copyright>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>CrtOverlay</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\crt.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Keep useful source locations without exposing the build machine's user directory. -->
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/_/CRT-Overlay</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectComposition" Version="3.8.3" />
    <EmbeddedResource Include="Shaders\*.hlsl" />
    <EmbeddedResource Include="Assets\*.ico" />
    <EmbeddedResource Include="Locales\*.json" WithCulture="false" />
    <EmbeddedResource Include="Profiles\*.json" WithCulture="false" />
    <None Update="Shaders\*.hlsl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CompileHlsl" BeforeTargets="CoreCompile" Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\CompileShaders.ps1&quot;" />
  </Target>
</Project>
